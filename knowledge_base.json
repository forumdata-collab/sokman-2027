      "方位": "正西（財位）",
      "化解": "一杯水",
      "原理": "八白屬土財星，水為財之源",
      "五行": "土克水?"
    },
    "9": {
      "星": "九紫右弼",
      "方位": "中宮（喜慶位）",
      "化解": "四盆植物及九枝紅花",
      "原理": "九紫屬火喜慶，植物木生火，紅花旺火",
      "五行": "木生火"
    }
  },
